/*
 * Description: Alternates two groups of LEDs on Port D.
 * Hardware: 6 LEDs connected to pins PD2, PD3, PD4, PD5, PD6, and PD7.
 * Pattern: PD2, PD4, PD6 (Group A) toggle with PD3, PD5, PD7 (Group B).
 */

#define F_CPU 16000000UL      // 16MHz clock speed
#include <avr/io.h>           // AVR I/O definitions
#include <util/delay.h>       // Busy-wait delay functions

int main(void)
{
    /* * DDRD (Data Direction Register D)
     * 0b11111100 means:
     * Pins 7, 6, 5, 4, 3, 2 are OUTPUTS (1)
     * Pins 1, 0 (RX/TX) are INPUTS (0) to avoid interfering with Serial communication
     */
    DDRD = 0b11111100;

    while (1)
    {
        /* * Group A ON: PD2, PD4, PD6 set to HIGH
         * Binary: 0 (PD7) 1 (PD6) 0 (PD5) 1 (PD4) 0 (PD3) 1 (PD2) 0 (PD1) 0 (PD0)
         */
        PORTD = 0b01010100;
        _delay_ms(500); // Wait 0.5 seconds

        /* * Group B ON: PD3, PD5, PD7 set to HIGH
         * Binary: 1 (PD7) 0 (PD6) 1 (PD5) 0 (PD4) 1 (PD3) 0 (PD2) 0 (PD1) 0 (PD0)
         */
        PORTD = 0b10101000;
        _delay_ms(500); // Wait 0.5 seconds
    }
}
